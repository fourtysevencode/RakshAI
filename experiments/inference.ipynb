   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "\n",
    "model_path = \"/Users/guestuser/Documents/RakshAI/best.onnx\"\n",
    "net = cv2.dnn.readNetFromONNX(model_path)\n",
    "\n",
    "class_names = {\n",
    "    0: \"Hardhat\",\n",
    "    1: \"Mask\",\n",
    "    2: \"NO-Hardhat\",\n",
    "    3: \"NO-Mask\",\n",
    "    4: \"NO-Safety Vest\",\n",
    "    5: \"Person\",\n",
    "    6: \"Safety Cone\",\n",
    "    7: \"Safety Vest\",\n",
    "    8: \"machinery\",\n",
    "    9: \"vehicle\",\n",
    "}\n",
    "\n",
    "input_size = 640\n",
    "confidence_threshold = 0.25\n",
    "nms_threshold = 0.45\n",
    "\n",
    "cap = cv2.VideoCapture(0)\n",
    "\n",
    "while True:\n",
    "    ok, frame = cap.read()\n",
    "\n",
    "    if not ok:\n",
    "        break\n",
    "\n",
    "    height, width = frame.shape[:2]\n",
    "\n",
    "    image = cv2.resize(frame, (input_size, input_size))\n",
    "\n",
    "    blob = cv2.dnn.blobFromImage(\n",
    "        image,\n",
    "        1 / 255.0,\n",
    "        (input_size, input_size),\n",
    "        swapRB=True,\n",
    "        crop=False\n",
    "    )\n",
    "\n",
    "    net.setInput(blob)\n",
    "    output = net.forward()\n",
    "\n",
    "    predictions = np.squeeze(output)\n",
    "\n",
    "    if predictions.ndim == 1:\n",
    "        predictions = predictions.reshape(1, -1)\n",
    "\n",
    "    elif predictions.shape[0] < predictions.shape[1]:\n",
    "        predictions = predictions.T\n",
    "\n",
    "    boxes = []\n",
    "    scores = []\n",
    "    class_ids = []\n",
    "\n",
    "    for prediction in predictions:\n",
    "\n",
    "        if len(prediction) < 5:\n",
    "            continue\n",
    "\n",
    "        cx, cy, box_w, box_h = prediction[:4]\n",
    "\n",
    "        # YOLOv5 / YOLOv7\n",
    "        if len(prediction) == 85:\n",
    "\n",
    "            objectness = prediction[4]\n",
    "            class_scores = prediction[5:]\n",
    "\n",
    "            class_id = int(np.argmax(class_scores))\n",
    "            score = float(\n",
    "                objectness * class_scores[class_id]\n",
    "            )\n",
    "\n",
    "        # YOLOv8 / YOLO11 style\n",
    "        else:\n",
    "\n",
    "            class_scores = prediction[4:]\n",
    "\n",
    "            class_id = int(np.argmax(class_scores))\n",
    "            score = float(class_scores[class_id])\n",
    "\n",
    "        if score < confidence_threshold:\n",
    "            continue\n",
    "\n",
    "        x = int(\n",
    "            (cx - box_w / 2)\n",
    "            * width\n",
    "            / input_size\n",
    "        )\n",
    "\n",
    "        y = int(\n",
    "            (cy - box_h / 2)\n",
    "            * height\n",
    "            / input_size\n",
    "        )\n",
    "\n",
    "        w = int(\n",
    "            box_w\n",
    "            * width\n",
    "            / input_size\n",
    "        )\n",
    "\n",
    "        h = int(\n",
    "            box_h\n",
    "            * height\n",
    "            / input_size\n",
    "        )\n",
    "\n",
    "        boxes.append([x, y, w, h])\n",
    "        scores.append(score)\n",
    "        class_ids.append(class_id)\n",
    "\n",
    "    indices = cv2.dnn.NMSBoxes(\n",
    "        boxes,\n",
    "        scores,\n",
    "        confidence_threshold,\n",
    "        nms_threshold\n",
    "    )\n",
    "\n",
    "    if len(indices) > 0:\n",
    "\n",
    "        for index in np.array(indices).flatten():\n",
    "\n",
    "            x, y, w, h = boxes[index]\n",
    "\n",
    "            class_id = class_ids[index]\n",
    "\n",
    "            class_name = class_names.get(\n",
    "                class_id,\n",
    "                f\"Unknown ({class_id})\"\n",
    "            )\n",
    "\n",
    "            label = f\"{class_name} ({class_id}): {scores[index]:.2f}\"\n",
    "\n",
    "            cv2.rectangle(\n",
    "                frame,\n",
    "                (x, y),\n",
    "                (x + w, y + h),\n",
    "                (0, 255, 0),\n",
    "                2\n",
    "            )\n",
    "\n",
    "            cv2.putText(\n",
    "                frame,\n",
    "                label,\n",
    "                (x, max(y - 10, 20)),\n",
    "                cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                0.6,\n",
    "                (0, 255, 0),\n",
    "                2\n",
    "            )\n",
    "\n",
    "    cv2.imshow(\n",
    "        \"ONNX Webcam Inference\",\n",
    "        frame\n",
    "    )\n",
    "\n",
    "    if cv2.waitKey(1) & 0xFF == ord(\"q\"):\n",
    "        break\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()"
   ]
  },
