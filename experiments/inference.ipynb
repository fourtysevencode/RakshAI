    "source": [
      "# Post-run class usage check and per-class counts",
      "from collections import defaultdict",
      "try:",
      "  counts = defaultdict(int)",
      "  if 'detections_all' in globals():",
      "    for item in detections_all:",
      "      dets = item.get('detections', []) or []",
      "      for det in dets:",
      "        cid = int(det.get('class_id', -1))",
      "        counts[cid] += 1",
      "  class_mapping = class_names if 'class_names' in globals() else {}",
      "  observed = sorted(counts.items())",
      "  print('Observed class_id counts:')",
      "  for cid, cnt in observed:",
      "    name = class_mapping.get(cid, f'Unknown({cid})')",
      "    print(f'  {cid} ({name}): {cnt}')",
      "  model_ids = sorted(list(class_mapping.keys())) if isinstance(class_mapping, dict) else []",
      "  observed_ids = [cid for cid, _ in observed]",
      "  missing_in_model = [cid for cid in observed_ids if cid not in model_ids]",
      "  if missing_in_model:",
      "    print('Warning: observed IDs not present in class mapping:', missing_in_model)",
      "  extra_in_model = [cid for cid in model_ids if cid not in observed_ids]",
      "  if extra_in_model:",
      "    print('Note: class_mapping contains IDs not observed in data:', extra_in_model)",
      "except Exception as e:",
      "  print('class usage check failed:', e)"
    ]
  }
